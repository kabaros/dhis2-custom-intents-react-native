{
    "name": "dhis2-custom-intent-app",
    "version": "0.0.1",
    "private": true,
    "scripts": {
        "android": "react-native run-android",
        "ios": "react-native run-ios",
        "lint": "eslint && prettier -c .",
        "start": "react-native start",
        "test": "jest",
        "format": "prettier . -w",
        "prepare": "husky"
    },
    "dependencies": {
        "@react-native/new-app-screen": "0.88.1",
        "react": "19.3.0",
        "react-native": "0.88.1",
        "react-native-safe-area-context": "^5.5.2"
    },
    "devDependencies": {
        "@babel/core": "^7.25.2",
        "@babel/preset-env": "^7.25.3",
        "@babel/runtime": "^7.25.0",
        "@dhis2/config-eslint": "0.4.0",
        "@dhis2/config-prettier": "0.4.0",
        "@eslint/compat": "^2.1.1",
        "@react-native-community/cli": "20.2.0",
        "@react-native-community/cli-platform-android": "20.2.0",
        "@react-native-community/cli-platform-ios": "20.2.0",
        "@react-native/babel-preset": "0.88.1",
        "@react-native/jest-preset": "0.88.1",
        "@react-native/metro-config": "0.88.1",
        "@react-native/typescript-config": "0.88.1",
        "@types/jest": "^29.5.13",
        "@types/react": "^19.2.0",
        "@types/react-test-renderer": "^19.1.0",
        "eslint": "^9.39.5",
        "husky": "^9.1.7",
        "jest": "^29.6.3",
        "lint-staged": "^17.6.0",
        "prettier": "^3.10.1",
        "react-test-renderer": "19.3.0",
        "typescript": "^6.0.3"
    },
    "engines": {
        "node": ">= 22.11.0"
    },
    "codegenConfig": {
        "name": "NativeCustomIntentSpec",
        "type": "modules",
        "jsSrcsDir": "specs",
        "android": {
            "javaPackageName": "org.dhis2.intentdemo.customintent"
        }
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx,mjs,cjs}": "eslint --fix --no-warn-ignored",
        "*": "prettier --write --ignore-unknown"
    }
}
